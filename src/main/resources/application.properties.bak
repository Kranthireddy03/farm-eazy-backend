## ===========================================
## SMS/MSG91 CONFIGURATION (UAT)
## ===========================================
## FarmEazy has 12 DLT-approved SMS templates via MSG91.
## SMS is sent based on user communication preferences.
##
## APPROVED TEMPLATES (DLT Verified):
## 1. FARMEAZY_LOGIN_OTP - Login OTP verification
## 2. FARMEAZY_PASSWORD_RESET_OTP - Password reset OTP
## 3. FARMEAZY_PAYMENT_SUCCESS - Payment confirmation
## 4. FARMEAZY_PAYMENT_FAILED - Payment failure alert
## 5. FARMEAZY_WELCOME - Welcome message after registration
## 6. FARMEAZY_BOOKING_CANCELLED - Booking cancellation
## 7. FARMEAZY_SERVICE_COMPLETED - Service completion
## 8. FARMEAZY_IRRIGATION_REMINDER - Irrigation alert
## 9. FARMEAZY_BANK_DETAILS_UPDATE_ALERT - Bank details change alert
## 10. FARMEAZY_BANK_DETAILS_ACTION_OTP - Bank action OTP
## 11. FARMEAZY_BOOKING_CONFIRM - Booking confirmation
## 12. FARMEAZY_SERVICE_STARTED - Service started notification
##
## Sender IDs:
## - FRMZOT: For OTP messages (login, password reset, bank OTP)
## - FMEAZY: For transactional messages (payments, bookings, etc.)
##
## Only MSG91_AUTH_KEY needs to be set as environment variable!
## ===========================================

## Master SMS Settings
msg91.enabled=true
msg91.authKey=${MSG91_AUTH_KEY:}
msg91.senderId=FRMZOT

## ===========================================
## MSG91 TEMPLATE IDs (DLT Approved)
## ===========================================

## FARMEAZY_LOGIN_OTP (Sender: FRMZOT)
## Template: "Your FARMEAZY OTP is ##otp##. It is valid for ##time## minutes. Do not share it with anyone. - FARMEAZY"
## Variables: otp, time
msg91.template.otp=69aa80d4663b879f870c0c83

## FARMEAZY_PASSWORD_RESET_OTP (Sender: FRMZOT)
## Template: "Your FARMEAZY password reset OTP is ##otp##. It is valid for ##time## minutes. Do not share it with anyone. - FARMEAZY"
## Variables: otp, time
msg91.template.password.reset=69aa83bec68f82ba17084ca2

## FARMEAZY_PAYMENT_SUCCESS (Sender: FMEAZY)
## Template: "Hi ##user##, payment of Rs ##rupees## for order ##orderID## was successful. Thank you for using FARMEAZY."
## Variables: user, rupees, orderID
msg91.template.payment.success=69aa830407d69373d20a97d3

## FARMEAZY_PAYMENT_FAILED (Sender: FMEAZY)
## Template: "Hi ##user##, your payment for order ##orderID## could not be completed. Please try again. - FARMEAZY."
## Variables: user, orderID
msg91.template.payment.failed=69aa8419579b232182019242

## FARMEAZY_WELCOME (Sender: FMEAZY)
## Template: "Welcome to FARMEAZY, ##user##! Your account has been created successfully. Happy farming."
## Variables: user
msg91.template.welcome=69aa82992b688ae615049392

## FARMEAZY_BOOKING_CANCELLED (Sender: FMEAZY)
## Template: "Hi ##user##, your booking ##BookingID## has been cancelled. Please contact support if you need assistance. - FARMEAZY"
## Variables: user, BookingID
msg91.template.booking.cancelled=69aa835909a2e8fb040ad7f3

## FARMEAZY_SERVICE_COMPLETED (Sender: FMEAZY)
## Template: "Hi ##user##, your service ##serviceId## has been completed successfully. Thank you for using FARMEAZY."
## Variables: user, serviceId
msg91.template.service.completed=69aa817b72381a761f0e5052

## FARMEAZY_IRRIGATION_REMINDER (Sender: FMEAZY)
## Template: "Reminder: Irrigation is due for ##IrrigationId## crop in your farm ##farm##. - FARMEAZY"
## Variables: IrrigationId, farm
msg91.template.irrigation=69aa82046a9b3765ba0ad9a3

## FARMEAZY_BANK_DETAILS_UPDATE_ALERT (Sender: FMEAZY)
## Template: "Your FARMEAZY bank details have been ##value## successfully. If this was not done by you, please contact support immediately. - FARMEAZY"
## Variables: value (added/updated/deleted)
msg91.template.bank.details.alert=69aaca9efd3e36f3ea0d9cf3

## FARMEAZY_BANK_DETAILS_ACTION_OTP (Sender: FRMZOT)
## Template: "Your FARMEAZY OTP for bank details ##value## verification is ##otp##. It is valid for ##time## minutes. Do not share it with anyone. - FARMEAZY"
## Variables: value (addition/update/deletion/viewing), otp, time
msg91.template.bank.details.otp=69aaca53f8742775250b4d02

## FARMEAZY_BOOKING_CONFIRM (Sender: FMEAZY)
## Template: "Hi ##user##, your booking ##orderID## has been confirmed successfully. - FARMEAZY"
## Variables: user, orderID
msg91.template.booking.confirm=69aabfdd61252f50400b5a52

## FARMEAZY_SERVICE_STARTED (Sender: FMEAZY)
## Template: "Hi ##user##, your service ##serviceID## has started. - FARMEAZY"
## Variables: user, serviceID
msg91.template.service.started=69aabf66097c7b8ee8088812

# Audit Logging
logging.level.AUDIT_LOGGER=INFO
logging.logger.AUDIT_LOGGER.name=AUDIT_LOGGER
logging.logger.AUDIT_LOGGER.level=INFO
logging.logger.AUDIT_LOGGER.additivity=false
logging.logger.AUDIT_LOGGER.handlers=FILE
logging.file.name=logs/audit.log
spring.datasource.hikari.maximum-pool-size=2
spring.datasource.hikari.minimum-idle=1
spring.datasource.hikari.idle-timeout=10000
spring.datasource.hikari.max-lifetime=30000
razorpay.key.id=${RAZORPAY_KEY_ID}
razorpay.key.secret=${RAZORPAY_SECRET}
spring.application.name=farmeazy-backend

# Allow circular references (needed for AuthService and SecurityConfig dependency)
spring.main.allow-circular-references=true

# PostgreSQL Configuration (Supabase) - ACTIVE FOR UAT
spring.datasource.url=jdbc:postgresql://db.cvxdennhjzagwubxktjr.supabase.co:5432/postgres
spring.datasource.driverClassName=org.postgresql.Driver
spring.datasource.username=postgres
spring.datasource.password=${DB_PASSWORD}

# JPA Configuration
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# H2 File-Based Database Configuration (Disabled for UAT - using Supabase)
# Data is stored in ./data/farmeazy_db
# spring.datasource.url=jdbc:h2:file:./data/farmeazy_db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# spring.datasource.driverClassName=org.h2.Driver
# spring.datasource.username=sa
# spring.datasource.password=
# spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
# spring.h2.console.enabled=true
# spring.h2.console.path=/h2-console


# Logging
logging.level.root=INFO
logging.level.com.farmeazy=DEBUG
logging.level.org.springframework=WARN
logging.level.org.springframework.boot=WARN
logging.level.org.springframework.boot.web.embedded.tomcat=INFO
logging.level.org.springframework.security=WARN

# JWT Configuration
jwt.secret=${JWT_SECRET:change-me-in-env}
jwt.expiration=86400000

# CORS Configuration
cors.allowed-origins=${CORS_ORIGINS:http://localhost:4200,http://localhost:3000,https://www.farm-eazy.com,https://farm-eazy.com}
cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS
cors.allowed-headers=*
cors.allow-credentials=true

# Swagger/OpenAPI Configuration
springdoc.api-docs.path=/v3/api-docs

# Email Configuration
spring.mail.host=${MAIL_SMTP_HOST:smtppro.zoho.in}
spring.mail.port=${MAIL_SMTP_PORT:587}
spring.mail.username=${MAIL_SMTP_USERNAME:no-reply@farm-eazy.com}
spring.mail.password=${MAIL_SMTP_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true


# FarmEazy Mail Configuration
farmeazy.mail.from=no-reply@farm-eazy.com
farmeazy.mail.enabled=true

# Multi-Sender Email Accounts (for different email types)
# no-reply - For automated notifications (OTP, verifications, system alerts) - Users should NOT reply
# info - For informational emails (welcome, product listings, updates)
# support - For support-related emails (password reset, bank issues, help)
farmeazy.mail.noreply=${MAIL_NOREPLY:no-reply@farm-eazy.com}
farmeazy.mail.info=${MAIL_INFO:info@farm-eazy.com}
farmeazy.mail.support=${MAIL_SUPPORT:support@farm-eazy.com}

# FarmEazy App Base URL (global domain for all communications)
farmeazy.app.base-url=https://www.farm-eazy.com

# File Upload Configuration
file.upload-dir=./uploads
spring.servlet.multipart.max-file-size=2MB
spring.servlet.multipart.max-request-size=10MB

# Dynamic port for Render/other platforms
server.port=${PORT:8080}
