# ===========================================
# FarmEazy Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values
# These override the defaults in application.properties

# ===========================================
# RAZORPAY PAYMENT GATEWAY
# ===========================================
# Get your keys from: https://dashboard.razorpay.com/app/keys

# Test Mode Keys (for development/testing)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Live Mode Keys (for production - starts with 'rzp_live_')
# RAZORPAY_KEY_ID=rzp_live_your_key_id_here
# RAZORPAY_KEY_SECRET=your_live_secret_key_here
# RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret_here

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# DB_URL=jdbc:mysql://localhost:3306/farmeazy_db
# DB_USERNAME=root
# DB_PASSWORD=your_db_password

# ===========================================
# AWS S3 ATTACHMENT STORAGE
# ===========================================
# AWS uses EC2 instance role FarmEazyEC2S3Role. Do not configure static keys.
aws.s3.region=ap-south-2
aws.s3.bucket-name=farmeazy-prod-attachments

# ===========================================
# JWT CONFIGURATION
# ===========================================
# JWT_SECRET=your_jwt_secret_key_here
# JWT_EXPIRATION=86400000

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================
# MAIL_HOST=smtppro.zoho.in
# MAIL_PORT=587
# MAIL_USERNAME=no-reply@farm-eazy.com
# MAIL_PASSWORD=your_email_password

# ===========================================
# RESEND API (Alternative Email Service)
# ===========================================
# RESEND_API_KEY=re_your_api_key_here

# ===========================================
# SMS/MSG91 CONFIGURATION
# ===========================================
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=FRMZY
# MSG91_TEMPLATE_ID=your_template_id
